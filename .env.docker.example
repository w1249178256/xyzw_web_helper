# Docker 部署环境变量样例
# 用法：cp .env.docker.example .env.docker && 填值
# .env.docker 已被 .gitignore 排除，不会进入版本库

# Supabase（render-backend 必需）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# render-backend API Key 鉴权（/api/* 除 /health 外全部需要）
API_KEY=change-me-to-a-long-random-string

# 前端访问端口（宿主机）
WEB_PORT=8080

# 私有扩展（默认关闭；公开部署不要开启）
# 注意：VITE_LOCAL_EXT* 是前端【构建期】变量，compose 的 env_file 不参与构建，
# 需写在仓库根 .env（compose 专用）或在 shell 导出，例如：
#   echo 'VITE_LOCAL_EXT=1' >> .env && docker compose build web
# VITE_LOCAL_EXT_ENTRY=<私有扩展入口的相对路径，按需填写>
